# Copy to .env (git-ignored) to override. These defaults are for local development only.
# Connection used by the provisioned "GeoFlow PostGIS" data source.
GEOFLOW_PG_HOST=postgres:5432
GEOFLOW_PG_DATABASE=geoflow
GEOFLOW_PG_USER=grafana_reader
# Must match GEOFLOW_READER_PASSWORD in docker/postgres/.env.
GEOFLOW_PG_PASSWORD=reader_dev_only
