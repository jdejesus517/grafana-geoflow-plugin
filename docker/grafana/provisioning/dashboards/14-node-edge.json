          }
        ]
      },
      "transformations": [],
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "geoflow-postgis"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "refId": "A",
          "rawSql": "SELECT site_id AS id, name, kind, ST_AsGeoJSON(geom, 6) AS geometry\nFROM geoflow.sites\nORDER BY site_id"
        },
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "geoflow-postgis"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "refId": "B",
          "rawSql": "SELECT trunk_id, a_site, z_site, medium, capacity_gbps, utilization_gbps\nFROM geoflow.trunks\nORDER BY trunk_id"
        }
      ]
    },
    {
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "geoflow-postgis"
      },
      "gridPos": {
        "h": 10,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "id": 2,
      "type": "jdejesusio-geoflow-panel",
      "title": "Problems",
      "description": "The network with problem rows added in SQL: a duplicate and a non-point node, an unknown node, a self-loop and an empty end; and a second Edges layer (query C), which isn't drawn.",
      "fieldConfig": {
        "defaults": {
          "custom": {
            "pointSize": 10,
            "lineWidth": 3
          }
        },
        "overrides": []
      },
      "options": {
        "basemap": {
          "kind": "none"
        },
        "view": {
          "mode": "fit",
          "lat": 35.737,
          "lon": -78.732,
          "zoom": 10,
          "padding": 30,
          "maxZoom": 17,
          "fitOnRefresh": false
        },
        "tooltip": "hover",
        "legend": {
          "show": true
        },
        "layerBinding": {
          "mode": "perFrame"
        },
        "layers": [
          {
            "id": "A",
            "name": "Sites",
            "role": "nodes"
          },
          {
            "id": "B",
            "name": "Trunks",
            "role": "edges"
          },
          {
            "id": "C",
            "name": "Microwave trunks",
            "role": "edges"
          }
        ]
      },
      "transformations": [],
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "geoflow-postgis"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "refId": "A",
          "rawSql": "SELECT * FROM (\n  SELECT site_id AS id, name, ST_AsGeoJSON(geom, 6) AS geometry, 1 AS seq FROM geoflow.sites\n  -- A second node with id 1, after the real one: the first wins.\n  UNION ALL SELECT 1, 'CARY-COPY', ST_AsGeoJSON(ST_SetSRID(ST_MakePoint(-78.70, 35.70), 4326), 6), 2\n  -- A node that isn't a point.\n  UNION ALL SELECT 9, 'TWIN-SITE', ST_AsGeoJSON(ST_GeomFromText('MULTIPOINT((-78.75 35.70), (-78.76 35.71))', 4326), 6), 1\n) nodes\nORDER BY id, seq"
        },
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "geoflow-postgis"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "refId": "B",
          "rawSql": "SELECT * FROM (\n  SELECT trunk_id, a_site, z_site FROM geoflow.trunks\n  UNION ALL SELECT 'BAD-1', '1', '99'   -- unknown node\n  UNION ALL SELECT 'BAD-2', '3', '3'    -- self-loop\n  UNION ALL SELECT 'BAD-3', NULL, '2'   -- empty end\n  UNION ALL SELECT 'BAD-4', '9', '4'    -- a node that isn't a point\n) edges\nORDER BY trunk_id"
        },
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "geoflow-postgis"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "refId": "C",
          "rawSql": "SELECT trunk_id, a_site, z_site\nFROM geoflow.trunks\nWHERE medium = 'microwave'\nORDER BY trunk_id"
        }
      ]
    },
