          "rawSql": "-- Shapes the adapter accepts but that aren't valid polygons or lines.\nSELECT id, name, geometry\nFROM (VALUES\n  (1, 'empty polygon ring', '{\"type\":\"Polygon\",\"coordinates\":[[]]}'),\n  (2, 'two-point ring', '{\"type\":\"Polygon\",\"coordinates\":[[[-78.786,35.788],[-78.785,35.789]]]}'),\n  (3, 'unclosed ring', '{\"type\":\"Polygon\",\"coordinates\":[[[-78.786,35.788],[-78.785,35.788],[-78.785,35.789]]]}'),\n  (4, 'zero-area ring', '{\"type\":\"Polygon\",\"coordinates\":[[[-78.786,35.788],[-78.786,35.788],[-78.786,35.788],[-78.786,35.788]]]}'),\n  (5, 'one-point line', '{\"type\":\"LineString\",\"coordinates\":[[-78.786,35.788]]}'),\n  (6, 'empty multipolygon part', '{\"type\":\"MultiPolygon\",\"coordinates\":[[]]}'),\n  (7, 'empty multiline part', '{\"type\":\"MultiLineString\",\"coordinates\":[[]]}'),\n  (8, 'valid point', '{\"type\":\"Point\",\"coordinates\":[-78.782,35.787]}')\n) AS t(id, name, geometry)\nORDER BY id",
