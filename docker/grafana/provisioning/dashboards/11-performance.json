          "rawQuery": true,
          "rawSql": "SELECT g AS id,\n  ST_AsGeoJSON(ST_MakePoint((g % 40) * 0.01, (g / 40) * 0.01), 6) AS geometry\nFROM generate_series(1, $rows) AS g\nORDER BY g",
